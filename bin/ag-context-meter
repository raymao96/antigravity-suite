#!/usr/bin/env bash
set -euo pipefail
DEFAULT_NODE_PATHS="${AG_DEFAULT_NODE_PATHS-/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/local/bin}"
if [ -n "$DEFAULT_NODE_PATHS" ]; then
  export PATH="${DEFAULT_NODE_PATHS}:$PATH"
fi

ensure_node_in_path() {
  if command -v node >/dev/null 2>&1; then
    return 0
  fi
  local cand nvm_dir nvm_root
  for cand in \
    "$HOME/.volta/bin" \
    "$HOME/.asdf/shims" \
    "$HOME/.local/share/mise/shims" \
    "$HOME/.fnm/current/bin" \
    "$HOME/Library/Application Support/fnm/aliases/default/bin"
  do
    if [ -x "$cand/node" ]; then
      export PATH="$cand:$PATH"
      return 0
    fi
  done
  nvm_root="${NVM_DIR:-$HOME/.nvm}/versions/node"
  if [ -d "$nvm_root" ]; then
    while IFS= read -r nvm_dir; do
      [ -n "$nvm_dir" ] || continue
      if [ -x "$nvm_root/$nvm_dir/bin/node" ]; then
        export PATH="$nvm_root/$nvm_dir/bin:$PATH"
        return 0
      fi
    done < <(ls -1 "$nvm_root" 2>/dev/null | sort -V -r)
  fi
  return 0
}
ensure_node_in_path

resolve_real_node_bin_dir() {
  local resolved=""
  resolved="$(node -e 'const fs = require("fs"), path = require("path"); console.log(path.dirname(fs.realpathSync(process.execPath)));' 2>/dev/null || true)"
  if [ -n "$resolved" ] && [ -x "$resolved/node" ]; then
    echo "$resolved"
    return 0
  fi
  dirname "$(command -v node 2>/dev/null || echo /usr/bin/node)"
}

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
DEFAULT_APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ -n "${AG_SUITE_DIR:-}" ] && [ -f "$AG_SUITE_DIR/cli.js" ]; then
  APP_DIR="$AG_SUITE_DIR"
elif [ -f "$DEFAULT_APP_DIR/cli.js" ]; then
  APP_DIR="$DEFAULT_APP_DIR"
elif [ -f "$HOME/.local/share/antigravity-suite/cli.js" ]; then
  APP_DIR="$HOME/.local/share/antigravity-suite"
else
  APP_DIR="$HOME/.local/share/antigravity-context-viewer"
fi

CURRENT_USER="$(id -un | tr -cd 'a-zA-Z0-9._-')"
LABEL="${AG_LIVE_LABEL:-com.${CURRENT_USER}.ag-live-helper}"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
STATE_FILE="$HOME/Library/Application Support/AntigravityContextMeter/.live-session.json"
FALLBACK_STATE_FILE="$HOME/.config/antigravity-context-meter/.live-session.json"
LEGACY_FILE="$APP_DIR/.live-session.json"
PORT_FILE="$HOME/Library/Application Support/Antigravity/DevToolsActivePort"
SOCKET_FILE="$HOME/Library/Application Support/Antigravity/SingletonSocket"
RELAUNCH_LOCK_DIR="${TMPDIR:-$HOME/Library/Application Support/AntigravityContextMeter}"
RELAUNCH_LOCK_DIR="${RELAUNCH_LOCK_DIR%/}"
RELAUNCH_LOCK_FILE="${AG_RELAUNCH_LOCK_FILE:-${RELAUNCH_LOCK_DIR}/ag-context-meter-relaunch.lock}"
LOG_DIR="$HOME/Library/Logs"
LOG_FILE="$LOG_DIR/antigravity-hans.log"

cmd="${1:-live}"

is_inside_antigravity_agent() {
  [ "${ANTIGRAVITY_AGENT:-}" = "1" ] || [ "${__CFBundleIdentifier:-}" = "com.google.antigravity" ]
}

has_active_cdp_target() {
  APP_DIR="$APP_DIR" node -e '
const { resolveActiveCdpTarget } = require(process.env.APP_DIR + "/asar-engine");
resolveActiveCdpTarget({ timeoutMs: 1200 })
  .then(r => process.exit(r && Array.isArray(r.targets) && r.targets.length > 0 ? 0 : 1))
  .catch(() => process.exit(1));
' >/dev/null 2>&1
}

get_bare_antigravity_info() {
  APP_DIR="$APP_DIR" node -e '
const { inspectAntigravityHostProcess } = require(process.env.APP_DIR + "/asar-engine");
const info = inspectAntigravityHostProcess();
if (info.running && !info.hasDebugSwitch && info.pid) {
  const elapsed = info.elapsedSec == null ? 9999 : info.elapsedSec;
  console.log(`${info.pid} ${elapsed}`);
}
' 2>/dev/null || true
}

has_antigravity_host_process() {
  APP_DIR="$APP_DIR" node -e '
const { inspectAntigravityHostProcess } = require(process.env.APP_DIR + "/asar-engine");
const info = inspectAntigravityHostProcess();
process.exit(info && info.running ? 0 : 1);
' >/dev/null 2>&1
}

is_shipit_running() {
  pgrep -x ShipIt >/dev/null 2>&1
}

find_antigravity_app() {
  if [ -d "/Applications/Antigravity.app" ]; then
    echo "/Applications/Antigravity.app"
    return 0
  fi
  if [ -d "$HOME/Applications/Antigravity.app" ]; then
    echo "$HOME/Applications/Antigravity.app"
    return 0
  fi
  return 1
}

relaunch_antigravity_with_cdp() {
  local live_args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --restart|--force|-f) ;;
      *) live_args+=("$arg") ;;
    esac
  done

  local ag_app
  ag_app="$(find_antigravity_app || true)"
  if [ -z "$ag_app" ]; then
    ag_app="/Applications/Antigravity.app"
  fi

  local bare_info bare_pid i
  bare_info="$(get_bare_antigravity_info || true)"
  bare_pid="${bare_info%% *}"
  if [ -n "${bare_pid:-}" ]; then
    mkdir -p "$(dirname "$RELAUNCH_LOCK_FILE")" 2>/dev/null || true
    printf '%s %s\n' "$(date +%s)" "$bare_pid" > "$RELAUNCH_LOCK_FILE" 2>/dev/null || true
  fi
  if [ -n "${bare_pid:-}" ]; then
    echo "正在优雅重启 Antigravity（补充 --remote-debugging-port=0）..."
    osascript -e 'tell application "Antigravity" to quit' >/dev/null 2>&1 || true
    for i in $(seq 1 16); do
      if ! kill -0 "$bare_pid" 2>/dev/null; then
        bare_pid=""
        break
      fi
      if [ "$i" -eq 8 ]; then
        kill -TERM "$bare_pid" 2>/dev/null || true
      fi
      sleep 0.5
    done
    if [ -n "${bare_pid:-}" ] && kill -0 "$bare_pid" 2>/dev/null; then
      echo "❌ 等待原 Antigravity 进程 (PID: $bare_pid) 退出超时，请手动按 ⌘Q 退出后再试。" >&2
      return 1
    fi
    sleep 0.3
  else
    echo "正在带调试端口启动 Antigravity..."
  fi

  open -a "$ag_app" --args --remote-debugging-port=0

  local ready=0
  for i in $(seq 1 40); do
    if has_active_cdp_target; then
      ready=1
      break
    fi
    sleep 0.5
  done
  if [ "$ready" -eq 0 ]; then
    echo "❌ 已重启 Antigravity，但等待调试端口就绪超时。" >&2
    return 1
  fi

  node "$APP_DIR/cli.js" live ${live_args[@]:+"${live_args[@]}"}
}

install_macos_launcher() {
  local ag_app
  ag_app="$(find_antigravity_app || true)"
  local target_app="${ag_app:-/Applications/Antigravity.app}"
  local launcher_dir="$HOME/Applications/Antigravity 增强启动器.app"
  local macos_dir="$launcher_dir/Contents/MacOS"
  local res_dir="$launcher_dir/Contents/Resources"
  local bin_path="$HOME/.local/bin/ag-context-meter"
  if [ ! -x "$bin_path" ]; then
    bin_path="$APP_DIR/bin/ag-context-meter"
  fi

  mkdir -p "$macos_dir" "$res_dir"

  if [ -n "$ag_app" ] && [ -f "$ag_app/Contents/Resources/icon.icns" ]; then
    cp -f "$ag_app/Contents/Resources/icon.icns" "$res_dir/icon.icns"
  fi

  cat > "$launcher_dir/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Antigravity 增强启动器</string>
  <key>CFBundleDisplayName</key>
  <string>Antigravity 增强启动器</string>
  <key>CFBundleIdentifier</key>
  <string>com.antigravity-suite.cdp-launcher</string>
  <key>CFBundleVersion</key>
  <string>1.0.0</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>launch</string>
  <key>CFBundleIconFile</key>
  <string>icon.icns</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
EOF

  local node_bin_dir
  node_bin_dir="$(resolve_real_node_bin_dir)"
  cat > "$macos_dir/launch" <<EOF
#!/usr/bin/env bash
export PATH="${node_bin_dir}:/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/local/bin:\$HOME/.local/bin:\$PATH"
BIN="${bin_path}"
TARGET_APP="${target_app}"
LOG_FILE="\$HOME/Library/Logs/antigravity-hans.log"
mkdir -p "\$HOME/Library/Logs"

notify() {
  osascript -e "display notification \"\$1\" with title \"Antigravity 增强启动器\"" >/dev/null 2>&1 || true
}

if "\$BIN" status --json 2>/dev/null | grep -q '"running": true'; then
  open -a "\$TARGET_APP"
  notify "已检测到增强模式运行中，正在刷新挂载..."
  "\$BIN" live >> "\$LOG_FILE" 2>&1 || true
  exit 0
fi

if pgrep -f "/Antigravity\\.app/Contents/MacOS/Antigravity" >/dev/null 2>&1; then
  choice=\$(osascript -e 'button returned of (display dialog "Antigravity 当前正在运行，但未开启增强所需的调试端口（2.33.0+ 默认关闭）。\n\n是否现在重启 Antigravity 并自动开启全部增强功能？" with title "Antigravity 增强启动器" buttons {"取消", "重启并开启增强"} default button "重启并开启增强")' 2>/dev/null || echo "取消")
  if [ "\$choice" != "重启并开启增强" ]; then
    exit 0
  fi
  notify "正在重启 Antigravity 并加载增强功能，请稍候..."
  "\$BIN" restart --force >> "\$LOG_FILE" 2>&1
  if [ \$? -eq 0 ]; then
    notify "全部增强功能已加载完成！"
  else
    notify "重启挂载未完成，请打开终端运行 ag-context-meter status 确认原因。"
  fi
  exit 0
fi

notify "正在启动 Antigravity 增强版，请稍候..."
"\$BIN" open >> "\$LOG_FILE" 2>&1
if [ \$? -eq 0 ]; then
  notify "全部增强功能已加载完成！"
else
  notify "启动后未完成自动挂载，请在终端运行 ag-context-meter live。"
fi
EOF
  chmod +x "$macos_dir/launch"
  echo "✅ 已创建 macOS 零改包启动器: $launcher_dir"
  echo "   以后可直接从 Spotlight / 访达（~/Applications）打开它，或拖到程序坞代替原图标。"
}

has_live_antigravity() {
  if has_antigravity_host_process || has_active_cdp_target; then
    return 0
  fi
  return 1
}

try_auto_relaunch_fresh_bare() {
  local bare_pid="${1:-}"
  local bare_elapsed="${2:-}"

  if [ -z "$bare_pid" ] || [ -z "$bare_elapsed" ]; then
    if has_active_cdp_target; then
      return 0
    fi
    local bare_info
    bare_info="$(get_bare_antigravity_info || true)"
    if [ -z "${bare_info:-}" ]; then
      return 0
    fi
    bare_pid="${bare_info%% *}"
    bare_elapsed="${bare_info#* }"
  fi

  case "$bare_elapsed" in ''|*[!0-9]*) bare_elapsed=999 ;; esac

  local now_ts last_ts="" last_pid=""
  if [ -f "$RELAUNCH_LOCK_FILE" ]; then
    read -r last_ts last_pid < "$RELAUNCH_LOCK_FILE" 2>/dev/null || true
  fi

  if [ "$bare_elapsed" -gt 30 ]; then
    if [ "${last_pid:-}" != "skip:${bare_pid}" ]; then
      mkdir -p "$LOG_DIR" "$(dirname "$RELAUNCH_LOCK_FILE")" 2>/dev/null || true
      printf '0 skip:%s\n' "$bare_pid" > "$RELAUNCH_LOCK_FILE" 2>/dev/null || true
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] [_auto-trigger] 检测到 Antigravity (PID: $bare_pid, 已运行 ${bare_elapsed}s > 30s) 未带调试端口，为保护当前会话跳过自动重拉。" >> "$LOG_FILE"
    fi
    return 11
  fi

  if is_shipit_running; then
    return 12
  fi

  now_ts="$(date +%s)"
  case "${last_ts:-}" in ''|*[!0-9]*) last_ts=0 ;; esac
  if [ "${last_pid:-}" = "$bare_pid" ] && [ $((now_ts - last_ts)) -lt 20 ]; then
    return 11
  fi

  mkdir -p "$LOG_DIR" "$(dirname "$RELAUNCH_LOCK_FILE")" 2>/dev/null || true
  printf '%s %s\n' "$now_ts" "$bare_pid" > "$RELAUNCH_LOCK_FILE" 2>/dev/null || true
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] [_auto-trigger] 检测到 Antigravity (PID: $bare_pid, 启动 ${bare_elapsed}s) 未带调试端口，自动补参重拉..." >> "$LOG_FILE"
  relaunch_antigravity_with_cdp >> "$LOG_FILE" 2>&1 || true
  return 10
}

stop_live() {
  local stopped=0
  local f pid cmdline

  for f in "$STATE_FILE" "$FALLBACK_STATE_FILE" "$LEGACY_FILE"; do
    if [ -f "$f" ]; then
      pid=$(node -e "try{const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));if(d&&d.pid)console.log(d.pid)}catch{}" "$f" 2>/dev/null || true)
      if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
        cmdline=$(ps -p "$pid" -o command= 2>/dev/null || true)
        if echo "$cmdline" | grep -q "live-host.js"; then
          kill "$pid" 2>/dev/null || true
          stopped=1
          echo "已停止后台桥接服务 (PID: $pid)"
        fi
      fi
      rm -f "$f"
    fi
  done

  # 兜底清理残留的本项目 live-host.js 进程，避免 3 秒巡检重新注入
  pkill -f "$APP_DIR/live-host.js" 2>/dev/null && stopped=1 || true
  if [ "$stopped" -eq 0 ]; then
    echo "未发现运行中的后台桥接服务"
  else
    sleep 0.2
  fi

  # 通过 CDP 从当前 Antigravity 窗口卸载前端汉化与上下文看板
  local unload_count=0
  unload_count=$(APP_DIR="$APP_DIR" node -e '
const { resolveActiveCdpTarget } = require(process.env.APP_DIR + "/asar-engine");
(async () => {
  const { targets: pages } = await resolveActiveCdpTarget({ timeoutMs: 2000 });
  if (!pages.length) {
    console.log("0");
    return;
  }

  let count = 0;
  for (const page of pages) {
    if (!page.webSocketDebuggerUrl) continue;
    try {
      await new Promise((resolve) => {
        const ws = new WebSocket(page.webSocketDebuggerUrl);
        const timer = setTimeout(() => {
          try { ws.close(); } catch {}
          resolve();
        }, 3000);

        ws.addEventListener("open", () => {
          ws.send(
            JSON.stringify({
              id: 1,
              method: "Runtime.evaluate",
              params: {
                expression: [
                  "try { window.__AGEnhancer?.dispose?.(); } catch {}",
                  "try { delete window.__AGEnhancer; } catch {}",
                  "try { window.__AGY_CTX_CAPSULE_DISPOSE__?.(); } catch {}",
                  "try { delete window.__AGY_CTX_CAPSULE_ACTIVE__; } catch {}",
                  "try { window.__antigravityZhPatchCleanup?.(); } catch {}",
                  "try { delete window.__antigravityZhPatchInstalled; } catch {}",
                  "try { window.__AGContextMeter?.dispose?.(); } catch {}",
                  "try { delete window.__AGContextMeter; } catch {}",
                  "try { delete window.__AGContextMeterLive; } catch {}",
                  "void 0",
                ].join("; "),
                returnByValue: true,
              },
            })
          );
        });

        ws.addEventListener("message", (ev) => {
          try {
            const msg = JSON.parse(String(ev.data));
            if (msg.id === 1) {
              clearTimeout(timer);
              count += 1;
              try { ws.close(); } catch {}
              resolve();
            }
          } catch {}
        });

        ws.addEventListener("error", () => {
          clearTimeout(timer);
          resolve();
        });
      });
    } catch {}
  }

  console.log(String(count));
})();
' 2>/dev/null || echo "0")

  if [ "${unload_count:-0}" -gt 0 ] 2>/dev/null; then
    echo "已从当前窗口卸载中文汉化与上下文看板（已恢复英文原样）"
  fi
}

parse_etime_sec() {
  local raw="$1" days=0 hrs=0 mins=0 secs=0 rest
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  case "$raw" in
    *-*) days="${raw%%-*}"; rest="${raw#*-}" ;;
    *) rest="$raw" ;;
  esac
  local IFS=':'
  local parts=()
  read -r -a parts <<< "$rest"
  case "${#parts[@]}" in
    3) hrs="${parts[0]}"; mins="${parts[1]}"; secs="${parts[2]}" ;;
    2) mins="${parts[0]}"; secs="${parts[1]}" ;;
    1) secs="${parts[0]}" ;;
    *) echo 9999; return 0 ;;
  esac
  case "${days}${hrs}${mins}${secs}" in
    ''|*[!0-9]*) echo 9999; return 0 ;;
  esac
  echo $(( 10#$days * 86400 + 10#$hrs * 3600 + 10#$mins * 60 + 10#$secs ))
}

get_host_ps_line() {
  local ps_raw=""
  if [ -n "${AG_MOCK_PS_FILE:-}" ] && [ -f "$AG_MOCK_PS_FILE" ]; then
    ps_raw="$(cat "$AG_MOCK_PS_FILE" 2>/dev/null || true)"
  elif [ -n "${AG_MOCK_PS_OUTPUT+x}" ]; then
    ps_raw="$AG_MOCK_PS_OUTPUT"
  else
    ps_raw="$(ps -ax -o pid=,etime=,command= 2>/dev/null || true)"
  fi
  printf '%s\n' "$ps_raw" | grep '/Contents/MacOS/Antigravity' | grep -v -E 'Antigravity Helper|language_server|--type=|--import=|--headless' | head -n 1 || true
}

is_live_host_running() {
  local host_elapsed="${1:-}"
  if [ "${AG_MOCK_LIVE_HOST_RUNNING:-}" = "0" ]; then
    return 1
  fi
  if [ "${AG_MOCK_LIVE_HOST_RUNNING:-}" = "1" ]; then
    if [ -n "${AG_MOCK_LIVE_HOST_ELAPSED:-}" ] && [ -n "$host_elapsed" ]; then
      [ "$AG_MOCK_LIVE_HOST_ELAPSED" -le "$host_elapsed" ]
      return $?
    fi
    return 0
  fi
  local f pid cmdline live_etime live_elapsed
  for f in "$STATE_FILE" "$FALLBACK_STATE_FILE" "$LEGACY_FILE"; do
    if [ -f "$f" ]; then
      pid="$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$f" 2>/dev/null | head -n 1 || true)"
      if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
        cmdline="$(ps -p "$pid" -o command= 2>/dev/null || true)"
        if echo "$cmdline" | grep -q "live-host.js"; then
          if [ -n "$host_elapsed" ]; then
            live_etime="$(ps -p "$pid" -o etime= 2>/dev/null || true)"
            live_elapsed="$(parse_etime_sec "$live_etime")"
            if [ "${live_elapsed:-9999}" -gt "$host_elapsed" ]; then
              return 1
            fi
          fi
          return 0
        fi
      fi
    fi
  done
  pid="$(pgrep -f "$APP_DIR/live-host.js" 2>/dev/null | head -n 1 || true)"
  if [ -n "${pid:-}" ]; then
    if [ -n "$host_elapsed" ]; then
      live_etime="$(ps -p "$pid" -o etime= 2>/dev/null || true)"
      live_elapsed="$(parse_etime_sec "$live_etime")"
      if [ "${live_elapsed:-9999}" -gt "$host_elapsed" ]; then
        return 1
      fi
    fi
    return 0
  fi
  return 1
}

case "$cmd" in
  start|live)
    if has_active_cdp_target; then
      exec node "$APP_DIR/cli.js" live "${@:2}"
    fi
    bare_info="$(get_bare_antigravity_info || true)"
    if [ -n "${bare_info:-}" ]; then
      if is_inside_antigravity_agent; then
        echo "⚠️ 检测到当前 Antigravity (v2.33.0+) 未带调试端口运行，且脚本正在客户端内部会话中执行。" >&2
        echo "   已为你避开强制关闭当前窗口；请在外部终端执行: ag-context-meter restart（或按 ⌘Q 退出后重新点开 Antigravity，自启守护会自动注入）。" >&2
        exit 1
      fi
      relaunch_antigravity_with_cdp "${@:2}"
    else
      exec node "$APP_DIR/cli.js" live "${@:2}"
    fi
    ;;
  open|launch|restart)
    force_restart=0
    forward_args=()
    for arg in "${@:2}"; do
      case "$arg" in
        --force|-f) force_restart=1 ;;
        *) forward_args+=("$arg") ;;
      esac
    done
    if is_inside_antigravity_agent; then
      if [ "$force_restart" -eq 1 ]; then
        echo "⏳ 将在 1 秒后于后台平滑重启 Antigravity 并挂载插件…"
        nohup bash -c 'sleep 1; exec "$1" "$2" "${@:3}"' _ "$0" restart ${forward_args[@]:+"${forward_args[@]}"} >/dev/null 2>&1 &
        exit 0
      fi
      bare_info="$(get_bare_antigravity_info || true)"
      if [ -n "${bare_info:-}" ] || has_active_cdp_target; then
        echo "⚠️ 当前处于 Antigravity 内部会话，直接重启会中断当前对话。" >&2
        echo "   请在外部终端执行: ag-context-meter restart，或按 ⌘Q 退出后重新点击 Dock 图标（自启守护将自动挂载）。" >&2
        echo "   若确定要立刻重拉当前客户端，请运行: ag-context-meter restart --force" >&2
        exit 1
      fi
    fi
    relaunch_antigravity_with_cdp ${forward_args[@]:+"${forward_args[@]}"}
    ;;
  install-launcher)
    install_macos_launcher
    ;;
  stop)
    stop_live
    ;;
  auto-on)
    if [ ! -f "$PLIST" ]; then
      echo "未找到 LaunchAgent 配置文件: $PLIST" >&2
      exit 1
    fi
    node_bin_dir="$(resolve_real_node_bin_dir)"
    upgraded_msg="$(PLIST_PATH="$PLIST" SOCKET_PATH="$SOCKET_FILE" NODE_BIN_DIR="$node_bin_dir" node -e '
const fs = require("fs");
const p = process.env.PLIST_PATH;
const sock = process.env.SOCKET_PATH;
const nodeBin = process.env.NODE_BIN_DIR;
const escXml = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const unescXml = (s) => String(s)
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&quot;/g, "\"")
  .replace(/&apos;/g, "\x27")
  .replace(/&amp;/g, "&");
const stdPaths = [nodeBin, "/opt/homebrew/opt/node@22/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"];
const fullPath = Array.from(new Set(stdPaths.filter(Boolean))).join(":");
let xml = fs.readFileSync(p, "utf8");
const notes = [];

const lockPath = sock.replace(/SingletonSocket$/, "SingletonLock");
const escLockPath = escXml(lockPath);
const escSockPath = escXml(sock);
if (xml.includes(escLockPath)) {
  if (xml.includes(escSockPath)) {
    xml = xml.replace(new RegExp(`[ \\t]*<string>${escLockPath.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&")}<\\/string>\\r?\\n?`), "");
  } else {
    xml = xml.replace(escLockPath, escSockPath);
  }
  notes.push("WatchPaths 已由 SingletonLock 升级为 SingletonSocket");
} else if (!xml.includes(escSockPath)) {
  const next = xml.replace(/(<key>WatchPaths<\/key>\s*<array>)/, `$1\n    <string>${escSockPath}</string>`);
  if (next !== xml) {
    xml = next;
    notes.push("WatchPaths 已新增 SingletonSocket 监听");
  }
}

if (/<key>EnvironmentVariables<\/key>\s*<dict>/.test(xml)) {
  if (/<key>EnvironmentVariables<\/key>\s*<dict>(?:(?!<\/dict>)[\s\S])*?<key>PATH<\/key>\s*<string>([^<]*)<\/string>/.test(xml)) {
    xml = xml.replace(
      /(<key>EnvironmentVariables<\/key>\s*<dict>(?:(?!<\/dict>)[\s\S])*?<key>PATH<\/key>\s*<string>)([^<]*)(<\/string>)/,
      (m, pre, cur, post) => {
        const parts = unescXml(cur).split(":").filter(Boolean);
        if (nodeBin && !parts.includes(nodeBin)) {
          notes.push("EnvironmentVariables.PATH 已补充 Node 路径");
          return `${pre}${escXml([nodeBin, ...parts].join(":"))}${post}`;
        }
        return m;
      }
    );
  } else {
    xml = xml.replace(
      /(<key>EnvironmentVariables<\/key>\s*<dict>)/,
      `$1\n    <key>PATH</key>\n    <string>${escXml(fullPath)}</string>`
    );
    notes.push("EnvironmentVariables 已补充 PATH");
  }
} else {
  const envBlock = `  <key>EnvironmentVariables</key>\n  <dict>\n    <key>PATH</key>\n    <string>${escXml(fullPath)}</string>\n  </dict>\n`;
  const next = xml.replace(/(^[ \t]*<key>RunAtLoad<\/key>)/m, `${envBlock}$1`);
  if (next !== xml) {
    xml = next;
    notes.push("已新增 EnvironmentVariables.PATH");
  }
}

if (/<key>StartInterval<\/key>\s*<integer>(\d+)<\/integer>/.test(xml)) {
  xml = xml.replace(/(<key>StartInterval<\/key>\s*<integer>)(\d+)(<\/integer>)/, (m, pre, val, post) => {
    if (val !== "5") {
      notes.push(`StartInterval 已由 ${val} 更新为 5`);
      return `${pre}5${post}`;
    }
    return m;
  });
} else {
  const intervalBlock = "  <key>StartInterval</key>\n  <integer>5</integer>\n";
  const next = xml.replace(/(^[ \t]*<key>RunAtLoad<\/key>\s*<true\/>\r?\n)/m, `$1${intervalBlock}`);
  if (next !== xml) {
    xml = next;
    notes.push("已新增 StartInterval=5 轻量轮询");
  }
}
if (/<key>ThrottleInterval<\/key>\s*<integer>(\d+)<\/integer>/.test(xml)) {
  xml = xml.replace(/(<key>ThrottleInterval<\/key>\s*<integer>)(\d+)(<\/integer>)/, (m, pre, val, post) => {
    if (val !== "5") {
      notes.push(`ThrottleInterval 已由 ${val} 更新为 5`);
      return `${pre}5${post}`;
    }
    return m;
  });
} else {
  const throttleBlock = "  <key>ThrottleInterval</key>\n  <integer>5</integer>\n";
  const next = xml.replace(/(^[ \t]*<key>StartInterval<\/key>\s*<integer>\d+<\/integer>\r?\n)/m, `$1${throttleBlock}`);
  if (next !== xml) {
    xml = next;
    notes.push("已新增 ThrottleInterval=5");
  }
}

if (notes.length > 0) {
  fs.writeFileSync(p, xml, "utf8");
  console.log(notes.join("；"));
}
')"
    if [ -n "${upgraded_msg:-}" ]; then
      echo "✅ 已升级 LaunchAgent 配置（${upgraded_msg}）"
    fi
    uid="$(id -u)"
    launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$uid" "$PLIST"
    if has_active_cdp_target; then
      node "$APP_DIR/cli.js" live "${@:2}" || echo "提示：当前未能立即挂载，下次启动 Antigravity 时将自动挂载。"
    elif [ -n "$(get_bare_antigravity_info || true)" ]; then
      if is_inside_antigravity_agent; then
        echo "提示：已开启 v2.33.0+ 自启守护；当前窗口未开启调试端口且正在会话中，按 ⌘Q 重新点开 Antigravity 或在外部终端执行 ag-context-meter restart 后插件将自动恢复。"
      else
        relaunch_antigravity_with_cdp "${@:2}" || echo "提示：未能自动重启，请退出后重新点开 Antigravity。"
      fi
    else
      echo "提示：当前未检测到运行中的 Antigravity 窗口，待下次启动客户端时将自动挂载。"
    fi
    echo "已开启“启动 Antigravity 时自动加载”"
    ;;
  auto-off)
    uid="$(id -u)"
    launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
    echo "已关闭“启动 Antigravity 时自动加载”"
    stop_live
    ;;
  status)
    if [ "${2:-}" = "--json" ]; then
      exec node "$APP_DIR/cli.js" status
    fi

    auto_on=0
    if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
      auto_on=1
    fi

    status_rc=0
    status_out="$(node "$APP_DIR/cli.js" status 2>&1)" || status_rc=$?
    if [ "$status_rc" -ne 0 ]; then
      echo "获取运行状态失败：" >&2
      echo "$status_out" >&2
      exit "$status_rc"
    fi

    AUTO_ON="$auto_on" STATUS_JSON="$status_out" node -e '
const data = JSON.parse(process.env.STATUS_JSON);
const autoOn = process.env.AUTO_ON === "1";
const lw = data.liveWindow || {};
const ver = data.antigravityVersion ? ` (v${data.antigravityVersion})` : "";

console.log(`官方安装包${ver}：${data.asarPatched ? "⚠️ 检测到 app.asar 已被修改" : "✅ 未修改（官方签名完好）"}`);

if (!lw.running) {
  if (lw.cdpDisabled) {
    console.log("中文汉化：⭕ 未生效（客户端已运行但未开启调试端口；请按 ⌘Q 重开一次或在外部终端运行 ag-context-meter restart）");
    console.log("上下文看板：⭕ 未生效（等待调试端口就绪）");
    console.log("配额双胶囊：⭕ 未生效（等待调试端口就绪）");
    console.log("输入框快捷栏：⭕ 未生效（等待调试端口就绪）");
    console.log("底部能量胶囊：⭕ 未生效（等待调试端口就绪）");
  } else {
    console.log("中文汉化：⭕ 未生效（客户端未运行或调试端口未开启）");
    console.log("上下文看板：⭕ 未生效（客户端未运行或调试端口未开启）");
    console.log("配额双胶囊：⭕ 未生效（客户端未运行或调试端口未开启）");
    console.log("输入框快捷栏：⭕ 未生效（客户端未运行或调试端口未开启）");
    console.log("底部能量胶囊：⭕ 未生效（客户端未运行或调试端口未开启）");
  }
} else {
  console.log(`中文汉化：${lw.hansActive ? "✅ 已生效" : "⭕ 未启用"}`);
  const badge = lw.badgeText ? `（当前显示: ${lw.badgeText}）` : "";
  console.log(`上下文看板：${lw.active ? "✅ 已生效" + badge : "⭕ 未启用"}`);
  const quotaBadge = lw.quotaBadgeText ? `（当前显示: ${lw.quotaBadgeText}）` : "";
  console.log(`配额双胶囊：${lw.enhancerActive ? "✅ 已生效" + quotaBadge : "⭕ 未启用"}`);
  console.log(`输入框快捷栏：${lw.quickBarActive ? "✅ 已生效" : "⭕ 未启用"}`);
  const pulseBadge = lw.pulseText ? `（当前显示: ${lw.pulseText}）` : "";
  console.log(`底部能量胶囊：${lw.pulseActive ? "✅ 已生效" + pulseBadge : "⭕ 未启用"}`);
}

console.log(`随客户端自启：${autoOn ? "✅ 已开启" : "⭕ 未开启"}`);
const remoteDisabled = "${AG_DISABLE_MOBILE_REMOTE:-0}" === "1" || (() => {
  const fs = require("fs"), path = require("path"), os = require("os");
  const candidates = [
    path.join(os.homedir(), "Library/Application Support/AntigravityContextMeter/.live-session.json"),
    path.join(os.homedir(), ".config/antigravity-context-meter/.live-session.json")
  ];
  for (const p of candidates) {
    try { if (JSON.parse(fs.readFileSync(p, "utf8"))?.remoteDisabled) return true; } catch {}
  }
  return false;
})();
console.log(remoteDisabled ? "手机远程操作：⚪ 已通过 --no-remote / AG_DISABLE_MOBILE_REMOTE=1 禁用" : "手机远程操作：✅ 已就绪（运行 ag-context-meter remote 扫码连接）");
'
    ;;
  remote)
    exec node "$APP_DIR/mobile-remote.js" --print-info "${@:2}"
    ;;
  _auto-trigger)
    host_line="$(get_host_ps_line)"
    if [ -z "$host_line" ]; then
      if ! is_shipit_running; then
        exit 0
      fi
    else
      read -r host_pid host_etime host_cmd <<< "$host_line"
      host_elapsed="$(parse_etime_sec "$host_etime")"
      if printf '%s\n' "$host_cmd" | grep -qE -- '--remote-debugging-port(=|[[:space:]]|$)'; then
        if is_live_host_running "$host_elapsed"; then
          exit 0
        fi
      else
        relaunch_rc=0
        try_auto_relaunch_fresh_bare "$host_pid" "$host_elapsed" || relaunch_rc=$?
        if [ "$relaunch_rc" -ne 12 ]; then
          exit 0
        fi
      fi
    fi

    mkdir -p "$LOG_DIR"
    for _ in $(seq 1 15); do
      host_line="$(get_host_ps_line)"
      if [ -z "$host_line" ]; then
        if is_shipit_running; then
          sleep 2
          continue
        fi
        exit 0
      fi
      read -r host_pid host_etime host_cmd <<< "$host_line"
      host_elapsed="$(parse_etime_sec "$host_etime")"
      if ! printf '%s\n' "$host_cmd" | grep -qE -- '--remote-debugging-port(=|[[:space:]]|$)'; then
        relaunch_rc=0
        try_auto_relaunch_fresh_bare "$host_pid" "$host_elapsed" || relaunch_rc=$?
        if [ "$relaunch_rc" -eq 10 ] || [ "$relaunch_rc" -eq 11 ]; then
          exit 0
        fi
        sleep 2
        continue
      fi
      if is_live_host_running "$host_elapsed"; then
        exit 0
      fi
      if has_active_cdp_target && node "$APP_DIR/cli.js" live >> "$LOG_FILE" 2>&1; then
        exit 0
      fi
      sleep 2
    done
    ;;
  check)
    exec node "$APP_DIR/cli.js" check
    ;;
  upstreams)
    exec node "$APP_DIR/scripts/check-upstreams.js" "${@:2}"
    ;;
  update)
    if node "$APP_DIR/cli.js" update "${@:2}"; then
      exit 0
    else
      exit $?
    fi
    ;;
  install|restore|uninstall|unlock|unlock-restore|chinese:*|proxy:enable|proxy:disable|proxy:set)
    echo "已禁用 '$cmd'：为保护 macOS 官方应用签名与账号合规，本命令禁止改盘注入 app.asar 及二进制补丁操作。" >&2
    exit 1
    ;;
  -h|--help|help)
    cat <<'EOF'
用法: ag-context-meter [命令] [选项]

常用命令:
  start / live   免改盘挂载「中文汉化 + 上下文看板」到当前窗口（默认；加 --no-remote 可禁用手机远程端口）
  open / restart 以带远程调试端口方式启动或平滑重启 Antigravity（适配 v2.33.0+）并热注入插件
  install-launcher [可选] 在 ~/Applications 创建「Antigravity 增强启动器.app」独立图标入口（适合 --no-auto 无守护场景）
  stop           停止后台守护进程，并卸载当前窗口的中文汉化与看板（恢复英文原样）
  auto-on        开启“启动 Antigravity 时自动加载”（含 v2.33.0+ 自动补参自愈）并立即尝试挂载
  auto-off       关闭“启动 Antigravity 时自动加载”，并停止/卸载当前挂载
  status         显示当前各项核心状态（加 --json 可输出原始 JSON 数据）
  update         从 GitHub 拉取最新版本并自动热刷新运行中窗口
  remote         打印手机极速版 PWA 远程操作链接与终端二维码（支持 --reset-token / --json）
  check          执行本地运行环境预检
  upstreams      检查 6 个参考上游项目的 GitHub 更新并与基线比对（支持 --json）
EOF
    ;;
  *)
    echo "未知命令: $cmd（请运行 ag-context-meter --help 以列出可用命令）" >&2
    exit 1
    ;;
esac
